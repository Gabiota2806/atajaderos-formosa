# Configuración general del prototipo
APP_NAME="Atajaderos Formosa · AI LAB"
APP_ENV=local

# Base de datos PostgreSQL 18 + PostGIS 3.7 (Docker)
POSTGRES_DB=atajaderos
POSTGRES_USER=atajaderos
POSTGRES_PASSWORD=atajaderos_secret

# Autenticación JWT (cambiar en despliegues fuera de demo local)
JWT_SECRET_KEY=dev-atajaderos-formosa-cambiar-en-produccion-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS (orígenes permitidos para el frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Asistente IA acotado (Human-in-the-Loop). Si queda vacío, degrada a modo determinístico offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Puertos locales de Docker Compose
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT_HOST=5432
